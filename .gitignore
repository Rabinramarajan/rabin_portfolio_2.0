# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent + runtime state (never commit)
/.claude-flow/
/.contact-messages/
/.claude/

# local audit / screenshot artifacts
/screenshots/
/responsive-screenshots/
/final-audit-screenshots/
*.log


.env*
# The template carries variable NAMES ONLY and must be committed — without
# this negation the blanket .env* rule silently swallows it.
!.env.example
.vercel



# playwright-mcp session artifacts
/.playwright-mcp/

# The build log is the release record: scripts/release.mjs picks the next
# version from it and scripts/generate-version.mjs rebuilds
# src/generated/version.json purely from it, with no merge against the
# committed copy. Ignoring it meant `npm run release` could not stage the file
# it had just written, and a fresh clone would regenerate version.json from an
# empty log and wipe the whole /version timeline. Tracked for that reason.
# Other publish/ artefacts stay ignored.
/publish/build-log-*.tmp
