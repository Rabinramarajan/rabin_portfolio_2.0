{
  "name": "rabin-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "npm run build && wrangler versions upload",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p worker/tsconfig.json",
    "preview": "npm run build && wrangler dev",
    "deploy:production": "npm run build && wrangler deploy",
    "deploy:production:secrets": "npm run build && wrangler deploy --secrets-file .secrets.env"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "gsap": "^3.15.0",
    "maplibre-gl": "6.11.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "turndown": "^7.2.4",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.149.0"
  }
}
