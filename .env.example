# ---------------------------------------------------------------------------
# rabinr.in — environment template
#
# Copy to .env.local for development. NAMES ONLY: never commit a real value to
# this file. Production/Preview values live in Vercel project settings
# (`vercel env add`), split per environment.
#
# Every variable here is OPTIONAL. The app degrades rather than crashes when
# one is unset — see the note against each block for what turns off.
# ---------------------------------------------------------------------------

# --- Media (Vercel Blob) ---------------------------------------------------
# Public READ origin of the Blob store. Public by design — a read-only CDN
# host, not a credential. Must match https://<store>.public.blob.vercel-storage.com;
# anything else is ignored and /public/media is served instead.
# Unset -> local /public/media is served.
NEXT_PUBLIC_BLOB_BASE_URL=

# Server-only Blob write token. NEVER prefix with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Admin credential for POST /api/blob/upload. Unset -> the route is off (fails
# closed, returns 401), which is the correct production default unless you are
# actively uploading.
BLOB_UPLOAD_SECRET=

# --- Contact form: SMTP (Zoho) ---------------------------------------------
# Unset -> /api/contact answers 503 "not configured" instead of silently
# dropping submissions. ZOHO_* is preferred; the SMTP_* names are accepted as
# a fallback for a non-Zoho relay.
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

# Addressing. Each falls back to the SMTP user / the profile address.
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=
CONTACT_TO_EMAIL=
# Set to "false" to stop sending the visitor an acknowledgement copy.
CONTACT_ACK_EMAIL=

# --- Chat assistant --------------------------------------------------------
# Unset -> the widget serves its scripted fallback answers, not an error.
# NVIDIA NIM is the only provider. Leave AI_PROVIDER unset or set it to "nvidia";
# AI_MODEL overrides the default model from the build.nvidia.com catalogue.
AI_PROVIDER=
AI_MODEL=
NVIDIA_API_KEY=
# Messages per client per 10 minutes. Defaults to 20; the e2e suite raises it.
CHAT_RATE_LIMIT=
# "true" logs prompt/routing detail. Development only — leave unset in prod.
DEBUG_CHAT=

# --- Analytics / consent ---------------------------------------------------
# All optional: each script tag is only rendered when its ID is present, so
# leaving these blank ships zero third-party JavaScript.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_COOKIESCRIPT_ID=

# --- Search Console verification -------------------------------------------
# Omitted from the document entirely when unset, so no placeholder ever ships
# as a real-looking verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
