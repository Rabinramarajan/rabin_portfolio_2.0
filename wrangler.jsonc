{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabin-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "routes": [{ "pattern": "rabinr.in", "custom_domain": true }],

  // Every route is prerendered to its own index.html; unknown paths get 404.html
  // with a real 404 status. Pages run the Worker first (Markdown negotiation and
  // discovery Link headers); static files (JS, CSS, images, fonts) never do.
  "assets": {
    "directory": "./dist/rabin-portfolio/browser",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*", "!/*.js", "!/*.css", "!/media/*", "!/fonts/*", "!/brand/*", "!/images/*", "!/*.png", "!/*.ico", "!/*.xml", "!/*.webmanifest"]
  },

  // Contact form delivery. The sender domain must be onboarded to Cloudflare
  // Email Service (`npx wrangler email sending enable rabinr.in`).
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["rabinr.dev@gmail.com"]
    }
  ],

  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "vars": {
    "CONTACT_TO_EMAIL": "rabinr.dev@gmail.com",
    "CONTACT_FROM_EMAIL": "contact@rabinr.in"
  }
}
