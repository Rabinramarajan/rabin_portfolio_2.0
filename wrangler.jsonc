{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabin-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // worker-mailer (SMTP for the contact form) needs Node.js compatibility
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "routes": [{ "pattern": "rabinr.in", "custom_domain": true }],

  // Every route is prerendered to its own index.html; unknown paths get 404.html
  // with a real 404 status. Pages run the Worker first (Markdown negotiation and
  // discovery Link headers); static files (JS, CSS, images, fonts) never do.
  "assets": {
    "directory": "./dist/rabin-portfolio/browser",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*", "!/*.js", "!/*.css", "!/media/*", "!/fonts/*", "!/brand/*", "!/images/*", "!/*.png", "!/*.ico", "!/*.xml", "!/*.webmanifest"]
  },

  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // Contact form delivery over your own SMTP mailbox.
  // Secrets (never in this file): npx wrangler secret put SMTP_USER / SMTP_PASSWORD
  // CONTACT_FROM_EMAIL must be the mailbox SMTP_USER signs in as (or an alias it may send from).
  "vars": {
    "CONTACT_TO_EMAIL": "rabinr.dev@gmail.com",
    "CONTACT_FROM_EMAIL": "hello@rabinr.in",
    "SMTP_HOST": "smtppro.zoho.in",
    "SMTP_PORT": "465"
  }
}
